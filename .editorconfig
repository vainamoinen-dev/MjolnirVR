# Editor settings for MjolnirVR. Matches the existing code: 4-space indents, LF endings, UTF-8.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,txt}]
trim_trailing_whitespace = false

[*.{yml,yaml,json}]
indent_size = 2
