// The VERSIONINFO block shared by the DLL and launcher resource scripts (the
// file's Properties > Details page). The including script defines
// VERSION_FILE_DESCRIPTION, VERSION_INTERNAL_NAME, VERSION_ORIGINAL_FILENAME and
// VERSION_FILE_TYPE first. The numbers come from generated/halomccvr_version.h
// (cmake/GitVersion.cmake, from git describe). No company or person is named.
#include <winver.h>
#include "halomccvr_version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION HALOMCCVR_VERSION_BINARY
 PRODUCTVERSION HALOMCCVR_VERSION_BINARY
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VERSION_FILE_TYPE
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", VERSION_FILE_DESCRIPTION
            VALUE "FileVersion", HALOMCCVR_VERSION_TEXT
            VALUE "InternalName", VERSION_INTERNAL_NAME
            VALUE "LegalCopyright", "MIT licence"
            VALUE "OriginalFilename", VERSION_ORIGINAL_FILENAME
            VALUE "ProductName", "MjolnirVR"
            VALUE "ProductVersion", HALOMCCVR_PRODUCT_VERSION_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
